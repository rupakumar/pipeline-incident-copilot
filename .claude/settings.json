      "Bash(.venv/bin/copilot evidence:*)",
      "Bash(.venv/bin/copilot search:*)",
      "Bash(.venv/bin/copilot check:*)",
      "Bash(.venv/bin/copilot check-fix:*)",
      "Bash(.venv/bin/copilot record:*)",
      "Bash(.venv/bin/copilot request-approval:*)",
      "Bash(.venv/bin/copilot show:*)",
