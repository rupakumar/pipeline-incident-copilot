# Copy to .env and fill in. .env is git-ignored — never commit or paste real values.

# Databricks Free Edition
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Jenkins (local Docker, Phase 2)
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=


# Langfuse Cloud (tracing + quality scores) — Project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US: https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_TRACING_ENABLED=true                # bulk eval scripts set this to false
