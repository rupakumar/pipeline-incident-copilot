    {
      "id": 3,
      "type": "table",
      "title": "Applications",
      "description": "Every watched pipeline on every connection, failing ones first, as of the watcher's last poll (copilot watch). Click an application for its tickets, a run number for the run on its platform.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "copilot-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "copilot-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT\n  CASE c.platform WHEN 'databricks' THEN 'Databricks' WHEN 'jenkins' THEN 'Jenkins' WHEN 'snowflake' THEN 'Snowflake' WHEN 'aws_glue' THEN 'AWS Glue' WHEN 'azure_data_factory' THEN 'Azure Data Factory' ELSE c.platform END AS \"Platform\",\n  c.name AS \"Connection\",\n  p.value AS \"Application\",\n  coalesce(h.last_state, 'not polled yet') AS \"Last run\",\n  CASE WHEN h.last_run_id IS NULL THEN '' ELSE '#' || h.last_run_id END AS \"Run\",\n  replace(substr(h.last_run_at, 1, 16), 'T', ' ') AS \"Last run at (UTC)\",\n  coalesce(h.runs_24h, 0) AS \"Runs 24 h\",\n  coalesce(h.failures_24h, 0) AS \"Failed 24 h\",\n  (SELECT count(*) FROM incidents i WHERE i.connection_id = c.connection_id AND i.pipeline = p.value AND i.status NOT IN ('resolved', 'rejected', 'closed')) AS \"Open tickets\",\n  (SELECT count(*) FROM incidents i WHERE i.connection_id = c.connection_id AND i.pipeline = p.value) AS \"All tickets\",\n  c.platform AS \"platform_key\",\n  h.last_run_url AS \"run_url\"\nFROM connections c, json_each(c.pipelines_json) p\nLEFT JOIN pipeline_health h ON h.connection_id = c.connection_id AND h.pipeline = p.value\nWHERE c.enabled\nORDER BY h.last_state IN ('FAILED', 'FAILURE', 'UNSTABLE') DESC, \"Open tickets\" DESC, c.name, p.value",
          "queryText": "SELECT\n  CASE c.platform WHEN 'databricks' THEN 'Databricks' WHEN 'jenkins' THEN 'Jenkins' WHEN 'snowflake' THEN 'Snowflake' WHEN 'aws_glue' THEN 'AWS Glue' WHEN 'azure_data_factory' THEN 'Azure Data Factory' ELSE c.platform END AS \"Platform\",\n  c.name AS \"Connection\",\n  p.value AS \"Application\",\n  coalesce(h.last_state, 'not polled yet') AS \"Last run\",\n  CASE WHEN h.last_run_id IS NULL THEN '' ELSE '#' || h.last_run_id END AS \"Run\",\n  replace(substr(h.last_run_at, 1, 16), 'T', ' ') AS \"Last run at (UTC)\",\n  coalesce(h.runs_24h, 0) AS \"Runs 24 h\",\n  coalesce(h.failures_24h, 0) AS \"Failed 24 h\",\n  (SELECT count(*) FROM incidents i WHERE i.connection_id = c.connection_id AND i.pipeline = p.value AND i.status NOT IN ('resolved', 'rejected', 'closed')) AS \"Open tickets\",\n  (SELECT count(*) FROM incidents i WHERE i.connection_id = c.connection_id AND i.pipeline = p.value) AS \"All tickets\",\n  c.platform AS \"platform_key\",\n  h.last_run_url AS \"run_url\"\nFROM connections c, json_each(c.pipelines_json) p\nLEFT JOIN pipeline_health h ON h.connection_id = c.connection_id AND h.pipeline = p.value\nWHERE c.enabled\nORDER BY h.last_state IN ('FAILED', 'FAILURE', 'UNSTABLE') DESC, \"Open tickets\" DESC, c.name, p.value",
          "timeColumns": []
        }
      ],
