          "queryType": "table",
          "rawQueryText": "SELECT CASE platform WHEN 'databricks' THEN 'Databricks' WHEN 'jenkins' THEN 'Jenkins' WHEN 'snowflake' THEN 'Snowflake' WHEN 'aws_glue' THEN 'AWS Glue' WHEN 'azure_data_factory' THEN 'Azure Data Factory' ELSE platform END || ' · ' || coalesce(pipeline, '?') AS application, count(*) AS tickets\nFROM incidents WHERE status NOT IN ('resolved', 'rejected', 'closed') GROUP BY application ORDER BY tickets DESC",
          "queryText": "SELECT CASE platform WHEN 'databricks' THEN 'Databricks' WHEN 'jenkins' THEN 'Jenkins' WHEN 'snowflake' THEN 'Snowflake' WHEN 'aws_glue' THEN 'AWS Glue' WHEN 'azure_data_factory' THEN 'Azure Data Factory' ELSE platform END || ' · ' || coalesce(pipeline, '?') AS application, count(*) AS tickets\nFROM incidents WHERE status NOT IN ('resolved', 'rejected', 'closed') GROUP BY application ORDER BY tickets DESC",
