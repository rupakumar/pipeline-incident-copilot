    {
      "id": 3,
      "type": "table",
      "title": "Scorecard: holdout incidents, current config",
      "description": "The diagnosis eval on the held-out incidents (never used to choose changes), tonight vs the night before.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "copilot-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "copilot-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "WITH latest AS (SELECT * FROM eval_runs WHERE label = 'baseline' AND split = 'test' ORDER BY id DESC LIMIT 1),\nprev AS (SELECT * FROM eval_runs WHERE label = 'baseline' AND split = 'test' ORDER BY id DESC LIMIT 1 OFFSET 1)\nSELECT m.key AS \"Metric\", m.value AS \"Tonight\",\n  (SELECT json_extract(prev.summary_json, '$.' || m.key) FROM prev) AS \"Previous night\"\nFROM latest, json_each(latest.summary_json) m\nWHERE m.key IN ('all_ok', 'class_ok', 'fact_ok', 'action_ok', 'context_recall', 'context_precision', 'faithfulness',\n                'brier_calibrated', 'escalated', 'mean_seconds', 'incidents')",
          "queryText": "WITH latest AS (SELECT * FROM eval_runs WHERE label = 'baseline' AND split = 'test' ORDER BY id DESC LIMIT 1),\nprev AS (SELECT * FROM eval_runs WHERE label = 'baseline' AND split = 'test' ORDER BY id DESC LIMIT 1 OFFSET 1)\nSELECT m.key AS \"Metric\", m.value AS \"Tonight\",\n  (SELECT json_extract(prev.summary_json, '$.' || m.key) FROM prev) AS \"Previous night\"\nFROM latest, json_each(latest.summary_json) m\nWHERE m.key IN ('all_ok', 'class_ok', 'fact_ok', 'action_ok', 'context_recall', 'context_precision', 'faithfulness',\n                'brier_calibrated', 'escalated', 'mean_seconds', 'incidents')",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "inspect": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Metric"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
