  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Self-improvement loop",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "copilot-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "copilot-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT\n  (SELECT count(*) FROM improvement_decisions WHERE verdict = 'accepted') AS \"Accepted (branches)\",\n  (SELECT count(*) FROM improvement_decisions WHERE verdict = 'rejected') AS \"Rejected\",\n  (SELECT count(*) FROM eval_runs) AS \"Eval runs\",\n  (SELECT replace(substr(max(at), 1, 16), 'T', ' ') FROM eval_runs) AS \"Last nightly (UTC)\"\n",
          "queryText": "SELECT\n  (SELECT count(*) FROM improvement_decisions WHERE verdict = 'accepted') AS \"Accepted (branches)\",\n  (SELECT count(*) FROM improvement_decisions WHERE verdict = 'rejected') AS \"Rejected\",\n  (SELECT count(*) FROM eval_runs) AS \"Eval runs\",\n  (SELECT replace(substr(max(at), 1, 16), 'T', ' ') FROM eval_runs) AS \"Last nightly (UTC)\"\n",
          "timeColumns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#1846C9"
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Accepted (branches)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00843D"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8C96A5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last nightly (UTC)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4E5D72"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Decisions (one change per night; accepted = a branch a person merges)",
      "description": "Every change the improver tried, the validator's verdict and reason. Nothing is merged automatically.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "copilot-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "copilot-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT replace(substr(at, 1, 16), 'T', ' ') AS \"When (UTC)\", kind AS \"Kind\", change AS \"Change\",\n  verdict AS \"Verdict\", reason AS \"Why\", coalesce(branch, '') AS \"Branch to review\",\n  json_extract(deltas_json, '$.quality') AS \"Quality Δ (tuning)\"\nFROM improvement_decisions ORDER BY id DESC LIMIT 50",
          "queryText": "SELECT replace(substr(at, 1, 16), 'T', ' ') AS \"When (UTC)\", kind AS \"Kind\", change AS \"Change\",\n  verdict AS \"Verdict\", reason AS \"Why\", coalesce(branch, '') AS \"Branch to review\",\n  json_extract(deltas_json, '$.quality') AS \"Quality Δ (tuning)\"\nFROM improvement_decisions ORDER BY id DESC LIMIT 50",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "inspect": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "When (UTC)"
            },
            "properties": [
