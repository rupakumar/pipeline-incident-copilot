          "queryType": "table",
          "rawQueryText": "SELECT replace(substr(at, 1, 16), 'T', ' ') AS \"When (UTC)\", label AS \"Run\", split AS \"Split\", config AS \"Config\",\n  json_extract(summary_json, '$.all_ok') AS \"All correct\", json_extract(summary_json, '$.context_recall') AS \"Context recall\",\n  json_extract(summary_json, '$.incidents') AS \"Incidents\"\nFROM eval_runs ORDER BY id DESC LIMIT 40",
          "queryText": "SELECT replace(substr(at, 1, 16), 'T', ' ') AS \"When (UTC)\", label AS \"Run\", split AS \"Split\", config AS \"Config\",\n  json_extract(summary_json, '$.all_ok') AS \"All correct\", json_extract(summary_json, '$.context_recall') AS \"Context recall\",\n  json_extract(summary_json, '$.incidents') AS \"Incidents\"\nFROM eval_runs ORDER BY id DESC LIMIT 40",
