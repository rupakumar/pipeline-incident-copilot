<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Watches every enabled connection and diagnoses new failures; restarted by launchd if it stops. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pipeline-copilot.watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT__/.venv/bin/copilot</string><string>watch</string><string>--diagnose</string>
    <string>--interval</string><string>60</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>EnvironmentVariables</key><dict><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__PROJECT__/data/runtime/logs/watcher.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/data/runtime/logs/watcher.log</string>
</dict>
</plist>
